<Window x:Class="RealTimeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Real-Time Radar Monitor"
        Height="700"
        Width="1200"
        Background="#111827">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="8"
                Padding="20">

            <Grid>
                <TextBlock Text="REAL-TIME RADAR MONITOR"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Ellipse Width="12"
                             Height="12"
                             Fill="LimeGreen"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="SYSTEM ONLINE"
                               Foreground="White"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>


        <!-- MAIN AREA -->
        <Grid Grid.Row="1" Margin="0,15,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- RADAR DISPLAY -->
            <Border Grid.Column="0"
                    Background="#0B1220"
                    BorderBrush="#374151"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,15,0">

                <Grid>

                    <TextBlock Text="RADAR DISPLAY"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="20"/>

                    <!-- Radar circles -->
                    <Ellipse Width="400"
                             Height="400"
                             Stroke="#374151"
                             StrokeThickness="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <Ellipse Width="300"
                             Height="300"
                             Stroke="#374151"
                             StrokeThickness="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <Ellipse Width="200"
                             Height="200"
                             Stroke="#374151"
                             StrokeThickness="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <Ellipse Width="100"
                             Height="100"
                             Stroke="#374151"
                             StrokeThickness="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <!-- Center -->
                    <Ellipse Width="10"
                             Height="10"
                             Fill="LimeGreen"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <!-- Example targets -->
                    <Ellipse Width="12"
                             Height="12"
                             Fill="Red"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="120,0,0,100"/>

                    <Ellipse Width="12"
                             Height="12"
                             Fill="Red"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="-150,80,0,0"/>

                    <Ellipse Width="12"
                             Height="12"
                             Fill="Red"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="80,-120,0,0"/>

                </Grid>
            </Border>


            <!-- RIGHT PANEL -->
            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- RADAR STATUS -->
                <Border Grid.Row="0"
                        Background="#1F2937"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="RADAR STATUS"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="● RADAR-01     ONLINE"
                                   Foreground="LimeGreen"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="● RADAR-02     ONLINE"
                                   Foreground="LimeGreen"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="● RADAR-03     ONLINE"
                                   Foreground="LimeGreen"
                                   FontSize="15"
                                   Margin="0,5"/>

                    </StackPanel>

                </Border>


                <!-- SELECTED TARGET -->
                <Border Grid.Row="1"
                        Background="#1F2937"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="SELECTED TARGET"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Track ID: 1001"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="Distance: 5.01 km"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="Azimuth: 20.25°"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="Velocity: 145 m/s"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="Confidence: 94%"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,5"/>

                        <TextBlock Text="Sources: RADAR-01, RADAR-02"
                                   Foreground="LightGray"
                                   FontSize="14"
                                   Margin="0,5"/>

                    </StackPanel>

                </Border>


                <!-- SYSTEM INFORMATION -->
                <Border Grid.Row="2"
                        Background="#1F2937"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="SYSTEM"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Targets detected: 7"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                        <TextBlock Text="Fused tracks: 4"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                        <TextBlock Text="Processing rate: 100 Hz"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                        <TextBlock Text="Queue: 12 messages"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>


        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#1F2937"
                CornerRadius="6"
                Padding="10">

            <TextBlock Text="Ready | Real-Time Processing Active"
                       Foreground="LightGray"
                       VerticalAlignment="Center"/>

        </Border>

    </Grid>

</Window>